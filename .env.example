# Hermes Engineering Platform — Anvio edition
# Copy to .env (gitignored) and fill in. Never commit real tokens.

# --- Runtime auth (ADR-009): Claude Pro/Max subscription OAuth ---
# Preferred: run `anvio setup-token --claude` — token is stored encrypted under workspace/connections/.
# Headless/CI alternative: paste the token from `claude setup-token` here.
CLAUDE_CODE_OAUTH_TOKEN=
# Encryption key for the connection broker (required when using the broker).
ANVIO_CONNECTION_ENCRYPTION_KEY=

# WARNING: do NOT set ANTHROPIC_API_KEY while runtime.provider is claude-code —
# an API key shadows OAuth and bills API credits instead of subscription quota.
# ANTHROPIC_API_KEY=

# --- Model provider (used only on the `local` fallback hop) ---
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# --- Channels ---
TELEGRAM_BOT_TOKEN=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# --- Workspace path (required — Anvio does NOT auto-discover from cwd) ---
ANVIO_WORKSPACE=./workspace

# --- Cursor delegation ---
CURSOR_API_KEY=
