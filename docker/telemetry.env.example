# Optional telemetry env for all Hermes agent containers.
# Copy to docker/telemetry.env and fill values.
# Usage: docker compose -f docker-compose.yaml -f docker-compose.telemetry.yaml ...

# --- PGVector semantic memory ---
MEMORY_DATABASE_URL=postgresql://hermes:hermes_memory_dev@postgres-memory:5432/hermes_memory
HERMES_TEAM_ID=default
HERMES_REPO_ID=hermes-engineering-platform

# --- Embeddings (OpenAI recommended; DeepSeek has no embedding API) ---
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1

# --- Langfuse LLM observability (cloud or self-hosted) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse:3000

# --- OpenTelemetry (exports to Langfuse OTLP + Prometheus) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=none
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production,service.namespace=hermes

# Per-container override in compose: OTEL_SERVICE_NAME=hermes-backend
